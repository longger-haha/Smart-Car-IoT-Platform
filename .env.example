# SmartRover 环境变量模板
# 使用前请复制本文件为 .env，并填入真实值
# cp .env.example .env

# ── Flask ──────────────────────────────────────────────────────────
FLASK_SECRET_KEY=replace-with-a-strong-random-string
FLASK_DEBUG=false

# ── JWT ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=replace-with-another-strong-secret

# ── MySQL ──────────────────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=sruser
MYSQL_PASSWORD=srpass123
MYSQL_DATABASE=smartrover_db

# ── MQTT (Mosquitto) ────────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=smartrover
MQTT_PASSWORD=replace-with-mqtt-password

# ── 安全参数 ────────────────────────────────────────────────────────
# 防重放时间窗口（秒），超出则拦截
REPLAY_WINDOW_SECONDS=30
# AES 加密密钥（必须恰好 16 字节）
AES_KEY=SmartRover2026!!

# ── 高德地图 ────────────────────────────────────────────────────────
AMAP_API_KEY=replace-with-your-amap-key
